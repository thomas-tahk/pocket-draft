{
  "name": "pocket-draft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --noEmit",
    "preview": "vite preview",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "scrape": "node scripts/scrape-limitless.mjs",
    "build:wasm": "cd server && GOOS=js GOARCH=wasm go build -o ../public/pd.wasm . && cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" ../public/wasm_exec.js",
    "build:wasm-site": "VITE_WASM=1 npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
